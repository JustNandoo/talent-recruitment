# Opsional untuk laptop: salin menjadi .env pribadi, lalu isi nilai di bawah.
# Untuk Vercel, isi ketiganya lewat Settings -> Environment Variables.
# Jangan unggah .env atau connection string asli ke GitHub.
DATABASE_URL=
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
# Setiap password berbeda, 12-128 karakter.
# Email login awal (opsional, sebelum database diinisialisasi):
SUPERADMIN_EMAIL=superadmin@serviam.local
ADMIN_EMAIL=admin@serviam.local
# Laptop memakai HTTP lokal. Vercel otomatis memakai HTTPS dan cookie Secure.
NODE_ENV=development
TALENTA_OPEN_BROWSER=false
# TLS database tetap aktif. Jika Supabase meminta CA tambahan, isi sertifikat
# resmi yang diunduh dari dashboard Supabase sebagai DATABASE_CA_CERT.
# DATABASE_CA_CERT=
