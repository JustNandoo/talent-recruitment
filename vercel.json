{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run vercel:check",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 60,
      "includeFiles": "{public/**,docs/**,db/**,node_modules/pdfjs-dist/legacy/build/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/handler"
    }
  ]
}
