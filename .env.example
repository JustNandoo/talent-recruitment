# Salin menjadi .env untuk mengubah konfigurasi lokal. Node 24+.
# .env dibaca otomatis; environment proses memiliki prioritas.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATA_DIR=.data
BOOTSTRAP_ACCOUNTS=true
SUPERADMIN_EMAIL=superadmin@serviam.local
ADMIN_EMAIL=admin@serviam.local
TRUST_PROXY=false
COOKIE_SECURE=false
# APP_ORIGIN=http://localhost:3000
# TALENTA_OPEN_BROWSER=false
# Undangan berupa link yang disalin dan dibagikan manual. Tidak memakai SMTP.
