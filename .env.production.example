# Docker Compose: salin menjadi .env dan isi domain sebenarnya.
APP_DOMAIN=ujian.perusahaan.example
SUPERADMIN_EMAIL=superadmin@serviam.local
ADMIN_EMAIL=admin@serviam.local
# Server Node tanpa Docker: gunakan nilai di bawah di belakang proxy HTTPS.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
APP_ORIGIN=https://ujian.perusahaan.example
COOKIE_SECURE=true
TRUST_PROXY=true
BOOTSTRAP_ACCOUNTS=false
TALENTA_OPEN_BROWSER=false
