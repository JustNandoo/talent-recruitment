{
  "name": "talenta-recruitment",
  "version": "1.6.0",
  "private": true,
  "description": "Ujian rekrutmen HRD Division PT Serviam Group Shipyard dengan akses sekali pakai, urutan soal per peserta, dan analisis penguji.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "admin:setup": "node scripts/setup-admin.js",
    "setup:accounts": "node scripts/setup-accounts.js",
    "backup": "node scripts/backup.js",
    "check:production": "node scripts/check-production.js",
    "vercel:check": "node scripts/check-vercel.js",
    "setup:supabase": "node scripts/setup-supabase.js",
    "test:postgres": "node --test tests/postgres.integration.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1"
  }
}
